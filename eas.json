{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "development-native": {
      "extends": "development",
      "env": {
        "AMPORA_NATIVE": "1",
        "EXPO_PUBLIC_AMPORA_NATIVE": "1"
      }
    },
    "preview-native": {
      "extends": "preview",
      "env": {
        "AMPORA_NATIVE": "1",
        "EXPO_PUBLIC_AMPORA_NATIVE": "1"
      }
    },
    "production-native": {
      "extends": "production",
      "env": {
        "AMPORA_NATIVE": "1",
        "EXPO_PUBLIC_AMPORA_NATIVE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
